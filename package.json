{
  "name": "gaussica",
  "version": "1.0.0",
  "private": true,
  "description": "Gaussica, lärstig i matematik med konton och lagring",
  "scripts": {
    "build": "node scripts/build-bundle.js",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning tests/run.js",
    "test:browser": "playwright test",
    "test:all": "npm test && playwright test",
    "test:changed": "node scripts/test-changed.js",
    "db:status": "node cloudflare/migrate.js",
    "db:migrate": "node cloudflare/migrate.js --apply"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
