  "exercise": {
    "prompt": "Hur många procent av rutorna är färgade?",
    "answer": [
      "35",
      "35%",
      "35 %"
    ],
    "correct": "Rätt! 35 av 100 rutor är 35 %.",
    "feedback": [
      {
        "answers": [
          "3,5",
          "3.5"
        ],
        "message": "Det finns 100 rutor, så antalet färgade rutor är procenttalet: 35 rutor är 35 %."
      }
    ],
    "visual": {
      "type": "hundrarutor",
      "filled": 35
    }
  },
  "wordProblems": [
    {
      "prompt": "Hur mycket är 20 % av 150 kr?",
      "answer": [
        "30",
        "30 kr"
      ],
      "correct": "Rätt! 150 · 20 ÷ 100 = 30 kr.",
      "feedback": [
        {
          "answers": [
            "20"
          ],
          "message": "20 är procenttalet. Räkna 20 hundradelar av 150."
        },
        {
          "answers": [
            "130"
          ],
          "message": "130 är 150 − 20. Procent av ett tal är en del av det, inte en subtraktion med procenttalet."
        }
      ]
    },
    {
      "prompt": "En tröja kostar 200 kr och sänks med 25 %. Vad kostar den nu?",
      "answer": [
        "150",
        "150 kr"
      ],
      "correct": "Rätt! Rabatten är 25 % av 200 = 50 kr, och 200 − 50 = 150 kr.",
      "feedback": [
        {
          "answers": [
            "50"
          ],
          "message": "50 kr är rabatten. Priset är det som är kvar: 200 − 50."
        },
        {
          "answers": [
            "175"
          ],
          "message": "175 är 200 − 25. Rabatten är 25 procent av priset, inte 25 kr."
        }
      ]
    }
  ]
